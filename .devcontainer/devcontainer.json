{
  "name": "Re:VIEW",
  "image": "mcr.microsoft.com/devcontainers/ruby:4",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1.1.0": {
      "version": "latest"
    },
    "./review": {
      "installPlaywright": true,
      "installFonts": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["yuqquu.review-starter-syntax-highlight"]
    }
  },
  "postCreateCommand": "bun install --frozen-lockfile"
}
